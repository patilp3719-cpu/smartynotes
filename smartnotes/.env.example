# AI Configuration
# AI_PROVIDER can be "gemini", "openai", or "mock"
AI_PROVIDER=mock
# Optional: Set the model explicitly. If unset, uses defaults (gemini-2.0-flash or gpt-4o-mini)
AI_MODEL=

# API Keys (Provide depending on AI_PROVIDER)
# GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here

# Optional SMTP for reminders (Not implemented yet, but placeholders)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user
# SMTP_PASSWORD=pass
